# Backend (Railway) environment
# Railway injects DATABASE_URL automatically when a Postgres service is attached.
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Set to "false" for local Postgres without TLS.
DATABASE_SSL=true

# Your Vercel URL(s), comma-separated. "*" allows all origins (fine for a demo).
FRONTEND_ORIGIN=https://your-app.vercel.app

# Optional — enables the AI assessment layer. Without it, assessments are rules-only.
ANTHROPIC_API_KEY=
# Optional override of the model used for assessment narratives.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Email magic-link sign-in ---------------------------------------------
# Without RESEND_API_KEY the sign-in link is printed to the server console,
# which is enough for local development.
RESEND_API_KEY=
AUTH_FROM_EMAIL=Consumer X <login@consumerx.in>
# Returns the sign-in link in the HTTP response instead of only mailing it.
# LOCAL DEVELOPMENT ONLY — with this on, knowing an address is enough to sign
# in as it. Never set it in production.
AUTH_DEV_ECHO=false

# --- Precedent retrieval ---------------------------------------------------
# Minimum normalised ts_rank a judgment must clear to be shown as comparable.
# Raise it if irrelevant cases still surface; lower it if the section is always
# empty. Tune against your ingested corpus.
PRECEDENT_MIN_RANK=0.05

PORT=3001
